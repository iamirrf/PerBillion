# PerBillion Environment Configuration
# Copy this file to .env and replace every change_me value before running.

# MongoDB
# Local Docker uses MONGO_PASSWORD to build the in-network MongoDB URI.
# For Atlas, set MONGODB_URI to your rotated SRV connection string, including the database.
# Example:
# MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/perbillion?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=perbillion

# If you run the local MongoDB container and want to override its password:
MONGO_PASSWORD=change_me_local_mongo_password

# JWT Configuration
JWT_SECRET=change_me_256_bit_jwt_secret
JWT_EXPIRY=7d

# AWS Configuration (for production deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
S3_BUCKET_NAME=perbillion-forecasts

# Alpha Vantage API (for stock data)
# Get your free API key at: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=change_me_alpha_vantage_key

# Transactional email (required for verification and password recovery)
# Create an API key after verifying the sending domain in Resend.
RESEND_API_KEY=change_me_resend_api_key
EMAIL_FROM=PerBillion <account@example.com>
PUBLIC_ORIGIN=http://localhost

# Application URLs
FRONTEND_URL=http://localhost
API_URL=http://localhost/api

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
FORECAST_DAILY_LIMIT=25
FORECAST_WORKERS=1
FORECAST_QUEUE_SIZE=8
FORECAST_STALE_AFTER_SECONDS=180

# Production Compose binds the app to localhost so a TLS reverse proxy can serve it.
# Set FRONTEND_URL above to the public HTTPS origin before a live deployment.
PERBILLION_HTTP_PORT=8088

# Environment
NODE_ENV=development
SPRING_PROFILES_ACTIVE=dev

# Membership (local Stripe test mode only until commercial capacity is funded)
# Both switches default to false in application code.
COMMERCIAL_LAUNCH_ENABLED=false
MEMBERSHIP_ENFORCEMENT_ENABLED=false
# Set this to at least 14 days after notifying existing accounts.
MEMBERSHIP_TRANSITION_ENDS_AT=
# Account creation cutoff for the 14-day legacy access notice (ISO-8601).
MEMBERSHIP_TRANSITION_CUTOFF_AT=
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_MEMBERSHIP_PRICE_ID=price_change_me
