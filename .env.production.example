# PerBillion production Compose example. Supply a TLS reverse proxy separately.
# Copy to a private .env on the deployment host; no live domain is confirmed.

MONGO_PASSWORD=change_me_strong_mongo_password
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/perbillion

# JWT
JWT_SECRET=change_me_256_bit_jwt_secret
JWT_EXPIRY=7d

# Obtain a market-data agreement that permits this public application.
ALPHAVANTAGE_API_KEY=change_me_licensed_market_data_key
FORECAST_DAILY_LIMIT=25

# Application URLs
FRONTEND_URL=https://your-domain.example
PERBILLION_HTTP_PORT=8088
